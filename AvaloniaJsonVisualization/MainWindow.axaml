<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="AvaloniaJsonVisualization.MainWindow"
        Title="AvaloniaJsonVisualization"
        WindowState="Maximized">

    <Window.Styles>
        <Style Selector="Thumb.ResizeHandle">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#3A3A3A"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Thumb.ResizeHandle:pointerover">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#555555"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14"
                    Spacing="8">

            <TextBlock Text="1. JSON Input"
                       FontSize="15"
                       FontWeight="Bold" />

            <Border x:Name="JsonInputBox"
                    Height="120"
                    MinHeight="60"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#101014"
                    Padding="8">

                <TextBox x:Name="JsonInput"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="Transparent"
                         BorderThickness="0"
                         Watermark="Paste JSON here..."
                         TextChanged="Input_OnTextChanged" />

            </Border>

            <Thumb Classes="ResizeHandle"
                   DragDelta="JsonInputResizeThumb_OnDragDelta" />

            <TextBlock Text="2. JSON Tree View"
                       FontSize="15"
                       FontWeight="Bold" />

            <Border x:Name="JsonTreeBox"
                    Height="220"
                    MinHeight="80"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#101014"
                    Padding="8">

                <TreeView x:Name="JsonTree" />

            </Border>

            <Thumb Classes="ResizeHandle"
                   DragDelta="JsonTreeResizeThumb_OnDragDelta" />

            <TextBlock Text="3. Visualizer Script"
                       FontSize="15"
                       FontWeight="Bold" />

            <Border x:Name="ScriptInputBox"
                    Height="120"
                    MinHeight="60"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#101014"
                    Padding="8">

                <TextBox x:Name="ScriptInput"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="Transparent"
                         BorderThickness="0"
                         Watermark="function render(data) { return html; }"
                         TextChanged="Input_OnTextChanged" />

            </Border>

            <Thumb Classes="ResizeHandle"
                   DragDelta="ScriptInputResizeThumb_OnDragDelta" />

            <TextBlock x:Name="StatusText"
                       Text="Waiting for input..."
                       Foreground="#CCC" />

            <Border x:Name="WebPreviewBox"
                    Height="420"
                    MinHeight="120"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Background="#08080B"
                    ClipToBounds="True">

                <NativeWebView x:Name="WebPreview" />

            </Border>

            <Thumb Classes="ResizeHandle"
                   DragDelta="WebPreviewResizeThumb_OnDragDelta" />

        </StackPanel>
    </ScrollViewer>

</Window>