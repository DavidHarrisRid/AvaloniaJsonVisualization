<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="AvaloniaJsonVisualization.MainWindow"
        Title="AvaloniaJsonVisualization"
        WindowState="Maximized">

    <Window.Styles>
        <!-- Kleiner grauer Resize-Griff unter jeder Box. -->
        <Style Selector="Thumb.ResizeHandle">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#3A3A3A"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Etwas hellerer Resize-Griff, wenn die Maus darüber ist. -->
        <Style Selector="Thumb.ResizeHandle:pointerover">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#555555"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="14"
                        Spacing="8">

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="JSON Visualizer"
                                   FontSize="22"
                                   FontWeight="Bold" />

                        <TextBlock Text="Paste JSON, edit JavaScript, and preview the visualization."
                                   Foreground="#999"
                                   FontSize="13" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Example"
                                       Foreground="#999"
                                       FontSize="12" />

                            <ComboBox x:Name="SampleSelector"
                                      Width="260"
                                      SelectionChanged="SampleSelector_OnSelectionChanged" />
                        </StackPanel>

                        <Button Background="DeepPink"
                                Width="44"
                                Height="44"
                                Content=" ?"
                                FontSize="22"
                                Padding="10"
                                FontWeight="Bold"
                                Click="HelpButton_OnClick" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="1. JSON Input"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="JsonInputBox"
                        Height="160"
                        MinHeight="80"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#101014"
                        Padding="0">

                    <!-- AvaloniaEdit ersetzt hier die normale TextBox.
                         Dadurch bekommt JSON Line-Numbers, Syntax-Highlighting und besseres Editor-Verhalten. -->
                    <avaloniaEdit:TextEditor x:Name="JsonInput"
                                             ShowLineNumbers="True"
                                             WordWrap="False"
                                             FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                             FontSize="13"
                                             Background="#101014"
                                             Foreground="#D1D5DB" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="JsonInputResizeThumb_OnDragDelta" />

                <TextBlock Text="2. JSON Tree View"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="JsonTreeBox"
                        Height="220"
                        MinHeight="80"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#101014"
                        Padding="8">

                    <TreeView x:Name="JsonTree" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="JsonTreeResizeThumb_OnDragDelta" />

                <TextBlock Text="3. Visualizer Script"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="ScriptInputBox"
                        Height="240"
                        MinHeight="100"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#101014"
                        Padding="0">

                    <!-- AvaloniaEdit ersetzt hier die normale TextBox.
                         Dadurch bekommt JavaScript Line-Numbers, Syntax-Highlighting und bessere Einrückung. -->
                    <avaloniaEdit:TextEditor x:Name="ScriptInput"
                                             ShowLineNumbers="True"
                                             WordWrap="False"
                                             FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                             FontSize="13"
                                             Background="#101014"
                                             Foreground="#D1D5DB" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="ScriptInputResizeThumb_OnDragDelta" />

                <TextBlock x:Name="StatusText"
                           Text="Waiting for input..."
                           Foreground="#CCC" />

                <TextBlock Text="4. WebView Preview"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="WebPreviewBox"
                        Height="420"
                        MinHeight="120"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="#08080B"
                        ClipToBounds="True">

                    <NativeWebView x:Name="WebPreview" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="WebPreviewResizeThumb_OnDragDelta" />

            </StackPanel>
        </ScrollViewer>

        <Border x:Name="HelpOverlay"
                IsVisible="False"
                Background="#F2161616">

            <Grid RowDefinitions="Auto,*"
                  Margin="32">

                <Border Grid.Row="0"
                        Background="#202020"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        Margin="0,0,0,18">

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="How this app works"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#F5F5F5" />

                            <TextBlock Text="A simple guide to JSON, data, render(data), and the WebView preview."
                                       FontSize="17"
                                       Foreground="#A3A3A3"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="Close"
                                FontSize="16"
                                Padding="24,12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="CloseHelpButton_OnClick" />
                    </DockPanel>

                </Border>

                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="34">

                    <ScrollViewer VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Spacing="30"
                                    MaxWidth="1000">

                            <StackPanel Spacing="12">
                                <TextBlock Text="The basic idea"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <TextBlock TextWrapping="Wrap"
                                           LineHeight="30"
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           Text="This app turns JSON data into a visual HTML preview. You paste JSON into the first editor, write a small JavaScript render function in the script editor, and the result appears in the WebView preview." />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Step 1: JSON input"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <TextBlock TextWrapping="Wrap"
                                           LineHeight="30"
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           Text="The first editor contains JSON data. The startup example has two values: name and power." />

                                <Border Background="#111111"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">

                                    <TextBlock FontFamily="Consolas"
                                               Foreground="#E5E7EB"
                                               FontSize="17"
                                               TextWrapping="Wrap">{ "name": "Device", "power": 42 }</TextBlock>

                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Step 2: The JSON becomes data"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <TextBlock TextWrapping="Wrap"
                                           LineHeight="30"
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           Text="Inside the JavaScript script, the parsed JSON is available as a variable named data. That means data.name gives you Device, and data.power gives you 42." />

                                <Border Background="#111111"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">

                                    <StackPanel Spacing="8">
                                        <TextBlock FontFamily="Consolas"
                                                   Foreground="#E5E7EB"
                                                   FontSize="17"
                                                   Text="data.name   -> Device" />

                                        <TextBlock FontFamily="Consolas"
                                                   Foreground="#E5E7EB"
                                                   FontSize="17"
                                                   Text="data.power  -> 42" />
                                    </StackPanel>

                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Step 3: render(data) creates the visual output"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <TextBlock TextWrapping="Wrap"
                                           LineHeight="30"
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           Text="The script editor must define a JavaScript function called render(data). This function returns HTML. The WebView shows that returned HTML." />

                                <Border Background="#111111"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">

                                    <TextBlock xml:space="preserve"
                                               FontFamily="Consolas"
                                               Foreground="#E5E7EB"
                                               FontSize="17"
                                               TextWrapping="Wrap">function render(data) {
    return `
        &lt;div style="padding: 28px;"&gt;
            &lt;h1 style="color: #FACC15; font-size: 34px;"&gt;${h(data.name)}&lt;/h1&gt;
            &lt;p style="color: #D1D5DB; font-size: 22px;"&gt;${h(data.power)} W&lt;/p&gt;
        &lt;/div&gt;
    `;
}</TextBlock>

                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Step 4: Use h(...) for JSON values"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <TextBlock TextWrapping="Wrap"
                                           LineHeight="30"
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           Text="When you show values from the JSON, use h(...). This safely converts the value into text for HTML. Example: h(data.name)." />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="The full flow"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <Border Background="#111111"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">

                                    <TextBlock xml:space="preserve"
                                               FontFamily="Consolas"
                                               Foreground="#E5E7EB"
                                               FontSize="17"
                                               LineHeight="28"
                                               TextWrapping="Wrap">JSON input
   ↓
C# parses the JSON
   ↓
JavaScript receives it as data
   ↓
render(data) returns HTML
   ↓
WebView shows the result</TextBlock>

                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="How to try your own data"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FACC15" />

                                <TextBlock TextWrapping="Wrap"
                                           LineHeight="30"
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           Text="First change the JSON. Then change the JavaScript to read the matching fields from data. For example, if your JSON has a field called temperature, you can use data.temperature in the script." />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </Border>
            </Grid>
        </Border>
    </Grid>

</Window>