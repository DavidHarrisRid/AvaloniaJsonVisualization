<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="AvaloniaJsonVisualization.MainWindow"
        Title="AvaloniaJsonVisualization"
        WindowState="Maximized">

    <Window.Styles>
        <Style Selector="Thumb.ResizeHandle">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#3A3A3A"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Thumb.ResizeHandle:pointerover">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#555555"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="14"
                        Spacing="8">

                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="JSON Visualizer"
                                   FontSize="22"
                                   FontWeight="Bold" />

                        <TextBlock Text="Paste JSON, edit JavaScript, and preview the visualization."
                                   Foreground="#999"
                                   FontSize="13" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Right"
                            Content="?"
                            FontSize="22"
                            FontWeight="Bold"
                            Click="HelpButton_OnClick" />
                </DockPanel>

                <TextBlock Text="1. JSON Input"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="JsonInputBox"
                        Height="120"
                        MinHeight="60"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#101014"
                        Padding="8">

                    <TextBox x:Name="JsonInput"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="Transparent"
                             BorderThickness="0"
                             Watermark="Paste JSON here..."
                             TextChanged="Input_OnTextChanged" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="JsonInputResizeThumb_OnDragDelta" />

                <TextBlock Text="2. JSON Tree View"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="JsonTreeBox"
                        Height="220"
                        MinHeight="80"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#101014"
                        Padding="8">

                    <TreeView x:Name="JsonTree" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="JsonTreeResizeThumb_OnDragDelta" />

                <TextBlock Text="3. Visualizer Script"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="ScriptInputBox"
                        Height="180"
                        MinHeight="60"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#101014"
                        Padding="8">

                    <TextBox x:Name="ScriptInput"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="Transparent"
                             BorderThickness="0"
                             Watermark="function render(data) { return html; }"
                             TextChanged="Input_OnTextChanged" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="ScriptInputResizeThumb_OnDragDelta" />

                <TextBlock x:Name="StatusText"
                           Text="Waiting for input..."
                           Foreground="#CCC" />

                <TextBlock Text="4. WebView Preview"
                           FontSize="15"
                           FontWeight="Bold" />

                <Border x:Name="WebPreviewBox"
                        Height="420"
                        MinHeight="120"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="#08080B"
                        ClipToBounds="True">

                    <NativeWebView x:Name="WebPreview" />

                </Border>

                <Thumb Classes="ResizeHandle"
                       DragDelta="WebPreviewResizeThumb_OnDragDelta" />

            </StackPanel>
        </ScrollViewer>

        <Border x:Name="HelpOverlay"
                IsVisible="False"
                Background="#CC000000"
                Padding="40">

            <Border MaxWidth="860"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1E1E1E"
                    BorderBrush="#666"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="680">

                    <StackPanel Spacing="16">

                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="How this app works"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F5F5F5" />

                            <Button DockPanel.Dock="Right"
                                    Content="Close"
                                    Padding="18,8"
                                    Click="CloseHelpButton_OnClick" />
                        </DockPanel>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#D4D4D4"
                                   FontSize="15"
                                   Text="This app turns JSON data into a visual HTML preview. You paste JSON into the first box, write a small JavaScript render function in the script box, and the result appears in the WebView preview." />

                        <TextBlock Text="Step 1: JSON input"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FACC15" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#D4D4D4"
                                   FontSize="15"
                                   Text="The first box contains JSON data. The startup example has two values: name and power." />

                        <Border Background="#111111"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">

                            <TextBlock FontFamily="Consolas"
                                       Foreground="#E5E7EB"
                                       TextWrapping="Wrap">{ "name": "Device", "power": 42 }</TextBlock>

                        </Border>

                        <TextBlock Text="Step 2: The JSON becomes data"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FACC15" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#D4D4D4"
                                   FontSize="15"
                                   Text="Inside the JavaScript script, the parsed JSON is available as a variable named data. That means data.name gives you Device, and data.power gives you 42." />

                        <Border Background="#111111"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">

                            <StackPanel Spacing="4">
                                <TextBlock FontFamily="Consolas"
                                           Foreground="#E5E7EB"
                                           Text="data.name   -> Device" />

                                <TextBlock FontFamily="Consolas"
                                           Foreground="#E5E7EB"
                                           Text="data.power  -> 42" />
                            </StackPanel>

                        </Border>

                        <TextBlock Text="Step 3: render(data) creates the visual output"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FACC15" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#D4D4D4"
                                   FontSize="15"
                                   Text="The script box must define a JavaScript function called render(data). This function returns HTML. The WebView shows that returned HTML." />

                        <Border Background="#111111"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">

                            <TextBlock FontFamily="Consolas"
                                       Foreground="#E5E7EB"
                                       TextWrapping="Wrap">function render(data) {
    return `
        &lt;h1&gt;${h(data.name)}&lt;/h1&gt;
        &lt;p&gt;${h(data.power)} W&lt;/p&gt;
    `;
}</TextBlock>

                        </Border>

                        <TextBlock Text="Step 4: Use h(...) for values from JSON"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FACC15" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#D4D4D4"
                                   FontSize="15"
                                   Text="When you show values from the JSON, use h(...). This safely converts the value into text for HTML. Example: h(data.name)." />

                        <TextBlock Text="The full flow"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FACC15" />

                        <Border Background="#111111"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">

                            <TextBlock FontFamily="Consolas"
                                       Foreground="#E5E7EB"
                                       TextWrapping="Wrap">JSON input
   ↓
C# parses the JSON
   ↓
JavaScript receives it as data
   ↓
render(data) returns HTML
   ↓
WebView shows the result</TextBlock>

                        </Border>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#A3A3A3"
                                   FontSize="14"
                                   Text="To try your own data, change the JSON first. Then change the JavaScript to read the matching fields from data." />

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>

</Window>